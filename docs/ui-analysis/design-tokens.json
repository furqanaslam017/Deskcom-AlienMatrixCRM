{
  "name": "Rapport Visual Design Tokens (Extracted & Re-engineered for AlienMatrix CRM)",
  "fontFamily": "Urbanist, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
  "fontWeights": {
    "regular": 400,
    "medium": 500,
    "semibold": 600,
    "bold": 700
  },
  "radii": {
    "card": "26px",
    "cardLarge": "32px",
    "cardSmall": "20px",
    "tile": "22px",
    "pill": "999px",
    "control": "999px",
    "circle": "50%"
  },
  "spacingScale": {
    "gap": "16px",
    "cardPadding": "24px",
    "dockWidth": "60px",
    "dockOffset": "20px",
    "gutter": "clamp(16px, 1.6vw, 28px)",
    "appMax": "1840px"
  },
  "transitions": {
    "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "durationFast": "150ms",
    "durationBase": "250ms",
    "durationSlow": "400ms"
  },
  "blur": {
    "card": "20px",
    "glass": "16px",
    "mesh": "60px"
  },
  "light": {
    "cssVars": {
      "--bg": "#ebe8e1",
      "--mesh-a": "#f2d3bd",
      "--mesh-b": "#cfdfcd",
      "--mesh-c": "#f1e4bf",
      "--glass": "#ffffff75",
      "--glass-2": "#ffffffa3",
      "--glass-3": "#ffffffd1",
      "--solid": "#f6f4ef",
      "--float": "#fdfcf9",
      "--well": "#17191a0f",
      "--line": "#17191a17",
      "--line-2": "#17191a29",
      "--rim": "#ffffffc7",
      "--shadow": "0 1px 0 #ffffffb3 inset, 0 24px 48px -30px #46321e47",
      "--shadow-pop": "0 24px 60px -18px #281e1452, 0 2px 6px #281e1414",
      "--text": "#17191a",
      "--muted": "#676a66",
      "--faint": "#8e918c",
      "--cream": "#fbf8f2",
      "--butter": "#f2c94c",
      "--on-butter": "#17191a",
      "--pine": "#2f5c50",
      "--on-pine": "#fbf8f2",
      "--tomato": "#c8431f",
      "--on-tomato": "#fbf8f2",
      "--ink": "#17191a",
      "--on-ink": "#fbf8f2",
      "--plain": "#ffffff94",
      "--on-plain": "#17191a",
      "--good": "#2f7a52",
      "--bad": "#c8431f",
      "--dock": "#17191a",
      "--on-dock": "#fbf8f2",
      "--pill": "#17191a",
      "--on-pill": "#fbf8f2"
    },
    "semantics": {
      "pageBackground": "#ebe8e1",
      "cardBackground": "rgba(255, 255, 255, 0.46)",
      "cardBackgroundAlt": "rgba(250, 246, 241, 0.85)",
      "cardBorder": "rgba(255, 255, 255, 0.78)",
      "cardShadow": "0 1px 0 rgba(255, 255, 255, 0.7) inset, 0 24px 48px -30px rgba(70, 50, 30, 0.28)",
      "textPrimary": "#17191a",
      "textMuted": "#676a66",
      "textFaint": "#8e918c",
      "dockBackground": "#17191a",
      "dockForeground": "#fbf8f2",
      "activePillBg": "#17191a",
      "activePillText": "#fbf8f2",
      "dealCardBg": "#17191a",
      "dealCardText": "#ffffff",
      "accentVermilion": "#c8431f",
      "accentPineGreen": "#2f5c50",
      "accentWarmButter": "#f2c94c"
    }
  },
  "dark": {
    "cssVars": {
      "--bg": "#111412",
      "--mesh-a": "#c8431f47",
      "--mesh-b": "#2f5c5080",
      "--mesh-c": "#f2c94c1a",
      "--glass": "#ffffff0d",
      "--glass-2": "#ffffff16",
      "--glass-3": "#222624",
      "--solid": "#1c201e",
      "--float": "#242927",
      "--well": "#ffffff0f",
      "--line": "#ffffff14",
      "--line-2": "#ffffff29",
      "--rim": "#ffffff12",
      "--shadow": "0 1px 0 #ffffff0d inset, 0 24px 48px -30px #000000b3",
      "--shadow-pop": "0 24px 60px -18px #000000b3, 0 0 0 1px #ffffff14",
      "--text": "#f1eee8",
      "--muted": "#a3a6a0",
      "--faint": "#7d807b",
      "--ink": "#f1eee8",
      "--on-ink": "#17191a",
      "--tomato": "#d8532d",
      "--plain": "#ffffff12",
      "--on-plain": "#f1eee8",
      "--good": "#6cc59a",
      "--bad": "#f08a68",
      "--dock": "#ffffff14",
      "--on-dock": "#f1eee8",
      "--pill": "#f1eee8",
      "--on-pill": "#17191a"
    },
    "semantics": {
      "pageBackground": "#111412",
      "cardBackground": "rgba(255, 255, 255, 0.05)",
      "cardBackgroundAlt": "rgba(28, 32, 30, 0.75)",
      "cardBorder": "rgba(255, 255, 255, 0.07)",
      "cardShadow": "0 1px 0 rgba(255, 255, 255, 0.05) inset, 0 24px 48px -30px rgba(0, 0, 0, 0.7)",
      "textPrimary": "#f1eee8",
      "textMuted": "#a3a6a0",
      "textFaint": "#7d807b",
      "dockBackground": "rgba(255, 255, 255, 0.08)",
      "dockForeground": "#f1eee8",
      "activePillBg": "#f1eee8",
      "activePillText": "#17191a",
      "dealCardBg": "#FAF6F1",
      "dealCardText": "#17191a",
      "accentVermilion": "#d8532d",
      "accentPineGreen": "#3D7A69",
      "accentWarmButter": "#f2c94c"
    }
  }
}
